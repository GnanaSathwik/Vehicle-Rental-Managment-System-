/E (create view customer_booking_summary as select      c.cust_id,     c.name as customer_name,     count\(b.booking_id\) as total_bookings,     sum\(b.pay_amount\) as total_booking_amount,     sum\(ifnull\(bl.total_amount, 0\)\) as total_billed_amount from customers c left join booking b on c.cust_id = b.cust_id left join billing bl on bl.booking_id = b.booking_id group by c.cust_id, c.name;)
