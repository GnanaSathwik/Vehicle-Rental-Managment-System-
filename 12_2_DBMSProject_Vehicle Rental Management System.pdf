/E (select      c.name as customer_name,     b.booking_id,     v.vehicle_num,     vm.model,     co.com_name as company,     b.start_date,     b.end_date,     b.pay_amount from booking b join customers c on b.cust_id = c.cust_id join vehicles v on b.vehicle_num = v.vehicle_num join vehicle_model vm on v.vehicle_id = vm.vehicle_id join company co on vm.company_id = co.com_id where b.cust_id in \(     select cust_id      from booking      group by cust_id      having count\(booking_id\) > 1 \) order by c.name;)
/Pg 42 0 R
/K [1]
