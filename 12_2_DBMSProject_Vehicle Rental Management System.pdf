471 0 obj
<<
/Type /StructElem
/S /H2
/T (delimiter $$ create procedure add_customer\(     in p_name varchar\(100\),     in p_phone varchar\(20\),     in p_mail varchar\(255\),     in p_street varchar\(120\),     in p_city varchar\(80\),     in p_state varchar\(80\),     in p_pincode varchar\(10\),     in p_license_no varchar\(50\) \) begin     insert into customers \(name, phone_num, mail_id, street, city, state, pincode, license_no\)     values \(p_name, p_phone, p_mail, p_street, p_city, p_state, p_pincode, p_license_no\); end $$ delimiter ;)
